{
  "manifest_version": 3,
  "name": "SubZero",
  "description": "The Apex YouTube Subscription Manager. Identify inactive channels and bulk unsubscribe.",
  "version": "0.1.0",
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/feed/channels*"
      ],
      "js": [
        "src/content/content-script.ts"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://www.youtube.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/injected.ts"
      ],
      "matches": [
        "*://www.youtube.com/*"
      ]
    }
  ]
}
